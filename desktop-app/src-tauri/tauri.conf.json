{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NebulaInk",
  "version": "1.0.0",
  "identifier": "com.nebulaink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "NebulaInk — Escrita sobre a tela",
        "width": 560,
        "height": 720,
        "minWidth": 520,
        "minHeight": 680,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
