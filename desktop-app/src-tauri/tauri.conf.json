{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NebulaInk",
  "version": "1.0.0",
  "identifier": "com.nebulaink.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NebulaInk — S Pen Vector Studio",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
